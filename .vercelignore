# Mirrors .gitignore: the Vercel CLI ignores .gitignore, and without this a
# plain `vercel` run would try to upload several GB of local logs and capture
# material. Keep the two files in step.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
build
out
.vercel
.cache
*.local
.env
.env.*
!.env.example

# Build-only source frames (4K facility renders → public/hero/facility-loop.*)
# Kept local; never committed. Regenerate outputs via scripts/build-hero-loop.ps1
/assets/

# OS
Thumbs.db

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.hero-tmp/
.gstack/

# Pristine pre-grade facility stills (seeded/graded by scripts/grade-facility-stills.py)
scripts/facility-originals/

# Local capture / scratch material. Raw walkthrough footage and generator
# source images live here; only the encoded outputs under public/ are committed.
assetss/
page 2 assets/
recovered-hero-videos/
dev/
scripts/copy_assets.js

# Python bytecode from scripts/build-hero-tour.py
__pycache__/

# Per-machine Claude Code state (.claude/launch.json is shared)
.claude/settings.local.json
